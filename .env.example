# Copia este archivo como .env y reemplaza los valores xxx.
# .env está en .gitignore: las contraseñas reales nunca se suben a GitHub.
POSTGRES_USER=gisuser
POSTGRES_PASSWORD=xxx
POSTGRES_DB=gisdb

# Proyecto 14 (14.6-14.7): dirección del webhook de n8n a la que el simulador envía las posiciones.
# Production URL (/webhook/, no /webhook-test/); 127.0.0.1 en lugar de localhost (demora de IPv6).
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/posiciones-brigadas
