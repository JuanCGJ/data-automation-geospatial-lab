    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    c.nombre             AS comuna,\n    c.nombre IS NOT NULL AS dentro\nFROM (\n    SELECT ST_Transform(ST_SetSRID(ST_MakePoint($1::float8, $2::float8), 4326), 6256) AS geom\n) p\nLEFT JOIN monitoreo.comunas c ON ST_Contains(c.geom, p.geom);",
