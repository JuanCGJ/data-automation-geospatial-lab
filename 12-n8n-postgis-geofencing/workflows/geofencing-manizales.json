      "parameters": {
        "operation": "executeQuery",
        "query": "   INSERT INTO monitoreo.alertas_geofence (nombre, lat, lon, geom)\n   VALUES (\n       $1,\n       $2::numeric,\n       $3::numeric,\n       ST_Transform(ST_SetSRID(ST_MakePoint($3::float8, $2::float8), 4326), 6256)\n   )\n   RETURNING id AS alerta_id, nombre, lat, lon, NULL AS comuna, false AS dentro, creado_en;",
        "options": {
          "queryReplacement": "=   {{ $('Webhook').item.json.body.nombre }},{{ $('Webhook').item.json.body.lat }},{{ $('Webhook').item.json.body.lon }}"
