{
  "name": "Lluvia A25 por comuna",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 6
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "id": "996584b2-f295-409a-9d50-7643ee9ff153",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT cr.id_comuna,\n       cr.nombre,\n       cr.nivel,\n       u.umbral_mm,\n       ROUND(ST_Y(ST_Transform(cc.geom, 4326))::numeric, 4) AS lat,\n       ROUND(ST_X(ST_Transform(cc.geom, 4326))::numeric, 4) AS lon\nFROM plataforma.comunas_riesgo cr\nJOIN plataforma.umbrales u          ON u.nivel = cr.nivel\nJOIN monitoreo.comunas_centroides cc ON cc.id_comuna = cr.id_comuna\n                                    AND cc.tipo = 'punto_interior'\nORDER BY cr.id_comuna;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "id": "ca589536-09e1-4cc1-bdf8-8d60c3152974",
      "name": "Leer comunas",
      "credentials": {
        "postgres": {
          "id": "u4qNVOL4Pb1ew3Ow",
          "name": "gisdb-local"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "5be32878-a98f-4911-9dca-1cf39f443b27",
              "name": "id_comuna",
              "value": "={{ $('Leer comunas').item.json.id_comuna }}",
              "type": "number"
            },
            {
              "id": "c369301e-fb35-468b-aac9-5d568aa2bfab",
              "name": "nombre",
              "value": "={{ $('Leer comunas').item.json.nombre }}",
              "type": "string"
            },
            {
              "id": "27b0b5e2-4d16-4d22-ae2a-f3fae4efb23a",
              "name": "umbral_mm",
              "value": "={{ Number($('Leer comunas').item.json.umbral_mm) }}",
              "type": "number"
            },
            {
              "id": "71245bcf-783f-4b68-a6d1-49ec4ede20b4",
              "name": "fecha",
              "value": "={{ $now.setZone('America/Bogota').toFormat('yyyy-MM-dd') }}",
              "type": "string"
            },
            {
              "id": "53eea374-d498-4639-9952-2c61ca5c3f6f",
              "name": "dias",
              "value": "={{ $json.daily.precipitation_sum.length }}",
              "type": "number"
            },
            {
              "id": "5370923a-7a45-492c-9e60-ec1c184fc42f",
              "name": "a25_mm",
              "value": "={{ Math.round($json.daily.precipitation_sum.reduce((suma, mm) => suma + (mm ?? 0), 0) * 10) / 10 }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        672,
        0
      ],
      "id": "69b8740e-4463-4434-ae4c-97e45dd45be5",
      "name": "Calcular A25"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO plataforma.lluvia_a25 (id_comuna, fecha, a25_mm)\nVALUES ($1::integer, $2::date, $3::numeric)\nON CONFLICT (id_comuna, fecha) DO UPDATE\n    SET a25_mm        = EXCLUDED.a25_mm,\n        consultado_en = now()\nRETURNING id_comuna, fecha, a25_mm;",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ $json.id_comuna }},{{ $json.fecha }},{{ $json.a25_mm }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        896,
        0
      ],
      "id": "5fb1aa45-06f6-4385-83af-976d8c00ad95",
      "name": "Guardar A25",
      "credentials": {
        "postgres": {
          "id": "u4qNVOL4Pb1ew3Ow",
          "name": "gisdb-local"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "b3774646-2e19-4623-82f7-40497bb6da97",
              "leftValue": "={{ $('Calcular A25').item.json.a25_mm }}",
              "rightValue": "={{ $('Calcular A25').item.json.umbral_mm }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1120,
        0
      ],
      "id": "e65adde4-99c7-4dd3-8987-caafd943c889",
      "name": "Supera umbral?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO plataforma.alertas (tipo, id_comuna, fecha, a25_mm, umbral_mm)\nVALUES ('riesgo_lluvia', $1::integer, $2::date, $3::numeric, $4::numeric)\nON CONFLICT (tipo, id_comuna, fecha) DO UPDATE\n    SET a25_mm    = EXCLUDED.a25_mm,\n        umbral_mm = EXCLUDED.umbral_mm\nRETURNING id, id_comuna, fecha, a25_mm, umbral_mm;",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ $('Calcular A25').item.json.id_comuna }},{{ $('Calcular A25').item.json.fecha }},{{ $('Calcular A25').item.json.a25_mm }},{{ $('Calcular A25').item.json.umbral_mm }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1344,
        -96
      ],
      "id": "4982e7c1-0720-4727-8e4e-41657486274b",
      "name": "Registrar alerta",
      "credentials": {
        "postgres": {
          "id": "u4qNVOL4Pb1ew3Ow",
          "name": "gisdb-local"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.open-meteo.com/v1/forecast?latitude={{ $json.lat }}&longitude={{ $json.lon }}&daily=precipitation_sum&start_date={{ $now.setZone('America/Bogota').minus({ days: 25 }).toFormat('yyyy-MM-dd') }}&end_date={{ $now.setZone('America/Bogota').minus({ days: 1 }).toFormat('yyyy-MM-dd') }}&timezone=America/Bogota",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {}
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "id": "50205516-f498-44d1-befd-f4848af2eef1",
      "name": "Consultar Open-Meteo"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- 14.8 Registrar alertas \"sin_cobertura\" (una sola ejecución: Settings → Execute Once).\n-- Comunas en alerta por lluvia HOY sin ninguna brigada activa (posición de los\n-- últimos 60 min) a menos de 1 km. Upsert: no duplica si se ejecuta otra vez el mismo día.\nWITH ultimas AS (\n    -- Última posición de cada brigada activa, si es de los últimos 60 minutos\n    SELECT DISTINCT ON (p.id_brigada)\n           p.id_brigada, p.geom\n    FROM plataforma.posiciones p\n    JOIN plataforma.brigadas b ON b.id_brigada = p.id_brigada AND b.activa\n    WHERE p.registrado_en >= now() - INTERVAL '60 minutes'\n    ORDER BY p.id_brigada, p.registrado_en DESC\n),\nsin_cobertura AS (\n    -- Comunas en alerta por lluvia hoy SIN ninguna brigada a menos de 1000 m\n    SELECT a.id_comuna, a.fecha, a.a25_mm, a.umbral_mm,\n           (SELECT ROUND(MIN(ST_Distance(cr.geom, u2.geom))::numeric)\n            FROM ultimas u2) AS m_mas_cercana\n    FROM plataforma.alertas a\n    JOIN plataforma.comunas_riesgo cr ON cr.id_comuna = a.id_comuna\n    WHERE a.tipo = 'riesgo_lluvia'\n      AND a.fecha = (now() AT TIME ZONE 'America/Bogota')::date\n      AND NOT EXISTS (SELECT 1 FROM ultimas u\n                      WHERE ST_DWithin(cr.geom, u.geom, 1000))\n)\nINSERT INTO plataforma.alertas (tipo, id_comuna, fecha, a25_mm, umbral_mm, detalle)\nSELECT 'sin_cobertura', id_comuna, fecha, a25_mm, umbral_mm,\n       CASE WHEN m_mas_cercana IS NULL\n            THEN 'Ninguna brigada activa reportó en los últimos 60 min'\n            ELSE 'Sin brigada activa a menos de 1 km; la más cercana a ' || m_mas_cercana || ' m'\n       END\nFROM sin_cobertura\nON CONFLICT (tipo, id_comuna, fecha) DO UPDATE\n    SET detalle = EXCLUDED.detalle,\n        creado_en = now()\nRETURNING id, tipo, id_comuna, fecha, a25_mm, umbral_mm, detalle;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1568,
        -96
      ],
      "id": "d2c6e3f5-dad6-408b-8446-0193a8b53a64",
      "name": "Evaluar cobertura",
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "u4qNVOL4Pb1ew3Ow",
          "name": "gisdb-local"
        }
      }
    }
